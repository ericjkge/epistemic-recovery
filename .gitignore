limo_experiment/models/

# local envs
.venv/
**/.venv/
venv/
!limo_experiment/sdpo_limo_llamafactory/outputs/
!limo_experiment/sdpo_limo_llamafactory/outputs/**
limo_experiment/sdpo_limo_llamafactory/outputs/**/merged/*.safetensors
# Intermediate training checkpoints (only the final adapter at the run root is needed for eval)
limo_experiment/sdpo_limo_llamafactory/outputs/**/checkpoint-*/
# Per-run state file written by train.sh
limo_experiment/sdpo_limo_llamafactory/.last_run_id
limo_experiment/sdpo_limo_llamafactory/.last_experiment

# Experiment-based layout (mirrors the outputs/ rules above)
!limo_experiment/sdpo_limo_llamafactory/experiments/
!limo_experiment/sdpo_limo_llamafactory/experiments/**
limo_experiment/sdpo_limo_llamafactory/experiments/**/merged/*.safetensors
limo_experiment/sdpo_limo_llamafactory/experiments/**/checkpoint-*/
# Smoke/dryrun experiments — local-only, not for git
limo_experiment/sdpo_limo_llamafactory/experiments/experiment_smoke/
limo_experiment/sdpo_limo_llamafactory/experiments/experiment_dryrun/
# Byte-compiled caches under experiments/ (the !experiments/** rule above re-includes
# everything, so re-exclude pycache explicitly)
limo_experiment/sdpo_limo_llamafactory/experiments/**/__pycache__/
limo_experiment/sdpo_limo_llamafactory/experiments/**/*.py[cod]

# Eval venv and locally-generated merged model (regenerated via eval/merge_lora.py)
limo_experiment/sdpo_limo_llamafactory/.venv-eval/
limo_experiment/sdpo_limo_llamafactory/.venv-train/
limo_experiment/sdpo_limo_llamafactory/saves/qwen3_sdpo_limo_lora_merged/
